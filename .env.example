# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/content_machine

# Apify
APIFY_TOKEN=your_apify_token

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key

# Vizard.ai
VIZARD_API_KEY=your_vizard_api_key
VIZARD_WEBHOOK_SECRET=your_webhook_secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# S3 (Optional/Existing)
S3_ENDPOINT=your_s3_endpoint
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your_bucket
S3_FORCE_PATH_STYLE=true

# Docker Configuration (Used by docker-compose)
DB_USER=admin
DB_PASSWORD=your_secure_password
DB_NAME=content_machine

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}
JWT_SECRET=your_super_secret_jwt_key

